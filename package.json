{
  "name": "rxlocal-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.chrischall/rxlocal-mcp",
  "description": "RxLocal (PioneerRx/RedSail) pharmacy patient-portal MCP server for Claude",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/rxlocal-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "rxlocal",
    "pioneerrx",
    "pharmacy",
    "model-context-protocol",
    "claude"
  ],
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "bin": {
    "rxlocal-mcp": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --alias:zod/v4=./node_modules/zod/v4/index.cjs --platform=node --format=esm --external:dotenv --define:process.env.WS_NO_BUFFER_UTIL=true --define:process.env.WS_NO_UTF_8_VALIDATE=true --banner:js='import { createRequire as __createRequire } from \"module\"; const require = __createRequire(import.meta.url);' --outfile=dist/bundle.js",
    "dev": "node --env-file=.env dist/index.js",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^3.3.2",
    "@fetchproxy/bootstrap": "^3.6.3",
    "@fetchproxy/server": "^3.6.3",
    "@modelcontextprotocol/server": "^2.3.0",
    "dotenv": "^18.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
